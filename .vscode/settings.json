{
  // ─────────────────────────────────────────────────────────────────────────
  // Default encoding: Windows-1252 for ALL project files.
  // NWN assets (scripts, GFF-JSON, TLK, 2DA, config) may contain accented
  // characters — the Aurora engine expects Windows-1252.
  // ─────────────────────────────────────────────────────────────────────────
  "files.encoding": "windows1252",
  "files.eol": "\n",

  // ─────────────────────────────────────────────────────────────────────────
  // Documentation ONLY: UTF-8
  // ─────────────────────────────────────────────────────────────────────────
  "[markdown]": {
    "files.encoding": "utf8bom"
  },

  // ─────────────────────────────────────────────────────────────────────────
  // NWScript language association
  // ─────────────────────────────────────────────────────────────────────────
  "files.associations": {
    "*.nss": "nwscript",
    "*.ncs": "nwscript"
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Editor defaults for NWScript
  // ─────────────────────────────────────────────────────────────────────────
  "[nwscript]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false
  }
}
